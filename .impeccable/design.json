  "narrative": {
    "northStar": "Hisab incumbent interface",
    "overview": "Hisab uses a black canvas, flat dark grouped surfaces, system typography and restrained gold actions. White amounts establish hierarchy; secondary labels recede while green and red communicate income and spending.\n\nThe Shop extension carries the incumbent visual system into a practical daily ledger. Entry speed, readable amounts, validation and honest totals take priority over decoration. This document records source evidence; runtime rendering has not been inspected.",
    "keyCharacteristics": [
      "Black canvas and tonal grouping",
      "System text and clear numeric hierarchy",
      "Gold actions; green and red financial meanings",
      "Persistent navigation and modal entry"
    ],
    "rules": [
      {
        "name": "Meaning Before Accent",
        "body": "Use gold for action and selection, green for positive financial values, and red for negative values and errors.",
        "section": "colors"
      },
      {
        "name": "Amount Before Annotation",
        "body": "Give totals stronger size and weight than their explanatory labels; use tabular numerals for ledger amounts.",
        "section": "typography"
      },
      {
        "name": "Flat Grouping",
        "body": "Group content with surface tone, spacing and separators; the ledger uses no decorative shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve platform system text through AppText unless a component explicitly opts into a named font.",
      "Do provide Android Back handling, safe-area and keyboard clearance in Shop forms.",
      "Do keep Shop controls at least 48 dp tall and explicitly enable text scaling.",
      "Do allow financial rows and section headers to wrap when space is tight."
    ],
    "donts": [
      "Don't force the theme's available Poppins fonts into the system-text wrapper.",
      "Don't collapse profit, collections and customer balances into one unexplained total.",
      "Don't add decorative shadows to the flat ledger surfaces."
    ]
  }
